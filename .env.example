# =============================================================================
# HMI Insan Cita - Backend environment
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# =============================================================================

PORT=3001

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Wajib untuk Supabase Storage, pengelolaan admin, dan operasi database server:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS: daftar origin frontend dipisahkan koma.
# Contoh produksi: https://hmi-insan-cita.vercel.app
CORS_ORIGINS=http://localhost:5173

# Media upload: "supabase" untuk produksi/Vercel, "local" untuk development.
# "auto" memakai Supabase bila service role tersedia atau saat berjalan di Vercel.
MEDIA_STORAGE=auto
SUPABASE_STORAGE_BUCKET=media
MAX_UPLOAD_MB=3
# UPLOAD_DIR=./uploads

# Koneksi database langsung (dipakai script migrate/create-admin/verify-db)
# Isi salah satu: DATABASE_URL atau DB_PASSWORD.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_NAME=postgres

# Akun admin awal (dipakai `npm run create-admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_NAME=Administrator

# URL publik backend, hanya dipakai untuk upload lokal (opsional).
# PUBLIC_BASE_URL=http://localhost:3001
